  "tornstats_api": {
    "base_url": "https://www.tornstats.com/api",
    "version": "v2",
    "endpoints": {
      "get_efficiency": {
        "method": "GET",
        "url": "v2/{api_key}/efficiency",
        "params": { "man": "int (optional)", "int": "int (optional)", "end": "int (optional)" },
        "response": {
          "status": true,
          "12": {
            "company": "Oil Company",
            "Director": 94.2,
            "Oil Courier": 68.5,
            "Accountant": 82.1,
            "Trainer": 71.3
          },
          "5": {
            "company": "Candle Shop",
            "Director": 91.0,
            "Salesperson": 65.2
          },
          "7": {
            "company": "Grocery Store",
            "Director": 88.4,
            "Cashier": 70.8,
            "Stock Clerk": 64.9
          }
        }
      },
      "get_faction_roster": {
        "method": "GET",
        "url": "v2/{api_key}/faction/roster",
        "response": {
          "status": true,
          "members": [
            { "name": "JohnKnot", "level": 75, "position": "Leader", "days_in_faction": 500 },
            { "name": "OilHand42", "level": 42, "position": "Member", "days_in_faction": 310 }
          ]
        }
      },
      "get_faction_skills": {
        "method": "GET",
        "url": "v2/{api_key}/faction/skills",
        "response": {
          "status": true,
          "skills": {
            "armory": 10,
            "medical": 8,
            "psychology": 5,
            "transport": 12
          }
        }
      },
      "validate_key": {
        "method": "GET",
        "url": "v2/{api_key}/",
        "response": {
          "status": true,
          "message": "Key valid"
        }
      },
      "errors": {
        "invalid_key": { "status": false, "message": "Invalid API key" },
        "rate_limited": { "status": false, "message": "Rate limited, please wait" }
      }
    }
  },
  "google_sheets": {
    "api_name": "Google Sheets API v4",
    "auth": "OAuth 2.0 (Desktop app flow) via gspread",
    "tabs": {
      "Company_History": {
        "write_style": "append (newest-first, inserted at row 2)",
        "headers": ["timestamp", "date", "name", "rating", "employees_hired", "employees_capacity", "daily_income", "daily_profit", "daily_customers", "weekly_income", "weekly_profit", "weekly_customers", "days_old", "company_funds", "popularity", "efficiency", "environment", "trains_available", "advertising_budget", "upgrade_company_size", "upgrade_staffroom_size", "upgrade_storage_size", "upgrade_storage_space", "total_wage", "avg_employee_effectiveness", "daily_stockcost", "avg_daily_profit_7day", "avg_daily_income_7day"],
        "sample_row": ["1776100000", "2026-07-14 12:00 UTC", "Knotty Oil Co", "9.2", "12", "15", "4250000", "3385000.0", "38", "29750000", "18930000.0", "266", "842", "87500000", "88", "92", "71", "3", "350000", "8", "5", "4", "750", "572000", "76.6", "45450.0", "3234000.0", "4100000.0"]
      },
      "Stock_History": {
        "write_style": "append (newest-first, inserted at row 2)",
        "headers": ["timestamp", "date", "name", "in_stock", "on_order", "cost", "price", "sold_amount", "sold_worth", "delta_in_stock", "delta_sold_amount", "delta_sold_worth", "created"],
        "sample_rows": [
          ["1776100000", "2026-07-14 12:00 UTC", "Premium Oil", "250", "0", "450", "1100", "40", "44000", "-10", "40", "44000", "30"],
          ["1776100000", "2026-07-14 12:00 UTC", "Standard Oil", "500", "100", "200", "500", "120", "60000", "-50", "120", "60000", "70"],
