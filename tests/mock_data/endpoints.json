      "get_company_timestamp_v2": {
        "method": "GET",
        "url": "v2/company/timestamp",
        "params": { "key": "{api_key}", "comment": "{comment}" },
        "response": { "timestamp": 1776100000 }
      },
      "get_company_listings": {
        "method": "GET",
        "url": "v2/company/{company_type_id}/companies",
        "params": { "limit": "int", "offset": "int", "key": "{api_key}", "comment": "{comment}" },
        "response": {
          "companies": [
            { "id": 220100, "name": "Quick Lube", "rating": 6.8, "income": { "weekly": 40000000 } },
            { "id": 220001, "name": "Knotty Oil Co", "rating": 9.2, "income": { "weekly": 29750000 } },
            { "id": 220200, "name": "Oil Express", "rating": 7.4, "income": { "weekly": 15000000 } }
          ],
          "_metadata": { "total": 3, "offset": 0, "limit": 100 }
        }
      },
      "check_key_info": {
        "method": "GET",
        "url": "v1/key",
        "params": { "selections": "info", "key": "{api_key}", "comment": "{comment}" },
        "response": {
          "key": "FICTIONAL_KEY_AB12",
          "player_id": 220001,
          "name": "JohnKnot",
          "level": 75,
          "access_type": "Limited",
          "access_level": 3,
          "expires": 1900000000
        }
      },
      "errors": {
        "rate_limited": { "error": { "code": 5, "error": "Too many requests (rate limited, max 100/min)" } },
        "incorrect_key": { "error": { "code": 2, "error": "Incorrect key" } },
        "key_disabled": { "error": { "code": 13, "error": "Key temporarily disabled (owner inactive 7+ days)" } },
        "empty_key": { "error": { "code": 1, "error": "Key is empty" } },
        "access_level": { "error": { "code": 16, "error": "Access level of this key is not high enough" } },
        "wrong_type": { "error": { "code": 3, "error": "Wrong type" } },
        "wrong_fields": { "error": { "code": 4, "error": "Wrong fields" } },
        "incorrect_id": { "error": { "code": 6, "error": "Incorrect ID" } },
        "no_permission": { "error": { "code": 7, "error": "Incorrect ID-entity relation (no permission to view this)" } },
        "ip_block": { "error": { "code": 8, "error": "IP block" } },
        "api_disabled": { "error": { "code": 9, "error": "API disabled" } },
        "daily_limit": { "error": { "code": 14, "error": "Daily read limit reached" } }
      }
    }
  },
  "tornstats_api": {
    "base_url": "https://www.tornstats.com/api",
    "version": "v2",
    "endpoints": {
      "get_efficiency": {
        "method": "GET",
        "url": "v2/{api_key}/efficiency",
        "params": { "man": "int (optional)", "int": "int (optional)", "end": "int (optional)" },
        "response": {
          "status": true,
          "12": {
            "company": "Oil Company",
            "Director": 94.2,
            "Oil Courier": 68.5,
            "Accountant": 82.1,
            "Trainer": 71.3
          },
          "5": {
            "company": "Candle Shop",
            "Director": 91.0,
            "Salesperson": 65.2
          },
          "7": {
            "company": "Grocery Store",
            "Director": 88.4,
            "Cashier": 70.8,
            "Stock Clerk": 64.9
          }
        }
      },
      "get_faction_roster": {
        "method": "GET",
        "url": "v2/{api_key}/faction/roster",
        "response": {
          "status": true,
          "members": [
            { "name": "JohnKnot", "level": 75, "position": "Leader", "days_in_faction": 500 },
            { "name": "OilHand42", "level": 42, "position": "Member", "days_in_faction": 310 }
          ]
        }
      },
      "get_faction_skills": {
        "method": "GET",
        "url": "v2/{api_key}/faction/skills",
        "response": {
          "status": true,
          "skills": {
            "armory": 10,
            "medical": 8,
            "psychology": 5,
            "transport": 12
          }
        }
      },
      "validate_key": {
        "method": "GET",
        "url": "v2/{api_key}/",
        "response": {
          "status": true,
          "message": "Key valid"
        }
      },
      "errors": {
        "invalid_key": { "status": false, "message": "Invalid API key" },
        "rate_limited": { "status": false, "message": "Rate limited, please wait" }
      }
    }
  },
  "google_sheets": {
    "api_name": "Google Sheets API v4",
    "auth": "OAuth 2.0 (Desktop app flow) via gspread",
    "tabs": {
      "Company_History": {
        "write_style": "append (newest-first, inserted at row 2)",
        "headers": ["timestamp", "date", "name", "rating", "employees_hired", "employees_capacity", "daily_income", "daily_profit", "daily_customers", "weekly_income", "weekly_profit", "weekly_customers", "days_old", "company_funds", "popularity", "efficiency", "environment", "trains_available", "advertising_budget", "upgrade_company_size", "upgrade_staffroom_size", "upgrade_storage_size", "upgrade_storage_space", "total_wage", "avg_employee_effectiveness", "daily_stockcost", "avg_daily_profit_7day", "avg_daily_income_7day"],
        "sample_row": ["1776100000", "2026-07-14 12:00 UTC", "Knotty Oil Co", "9.2", "12", "15", "4250000", "3385000.0", "38", "29750000", "18930000.0", "266", "842", "87500000", "88", "92", "71", "3", "350000", "8", "5", "4", "750", "572000", "76.6", "45450.0", "3234000.0", "4100000.0"]
      },
      "Stock_History": {
        "write_style": "append (newest-first, inserted at row 2)",
        "headers": ["timestamp", "date", "name", "in_stock", "on_order", "cost", "price", "sold_amount", "sold_worth", "delta_in_stock", "delta_sold_amount", "delta_sold_worth", "created"],
        "sample_rows": [
          ["1776100000", "2026-07-14 12:00 UTC", "Premium Oil", "250", "0", "450", "1100", "40", "44000", "-10", "40", "44000", "30"],
          ["1776100000", "2026-07-14 12:00 UTC", "Standard Oil", "500", "100", "200", "500", "120", "60000", "-50", "120", "60000", "70"],
          ["1776100000", "2026-07-14 12:00 UTC", "Filter Pack", "75", "0", "80", "250", "15", "3750", "-5", "15", "3750", "10"],
          ["1776100000", "2026-07-14 12:00 UTC", "Oil Canister", "30", "50", "600", "1500", "5", "7500", "0", "5", "7500", "5"]
        ]
      },
      "Employees": {
        "write_style": "overwrite each snapshot",
        "headers": ["tId", "name", "position", "wage", "days_in_company", "last_action_ts", "effectiveness_total", "effectiveness_working_stats", "effectiveness_settled_in", "effectiveness_director_education", "effectiveness_addiction", "effectiveness_inactivity", "effectiveness_management", "effectiveness_book", "effectiveness_merits"],
        "sample_rows": [
          ["220001", "JohnKnot", "Director", "200000", "842", "1776099600", "97", "42", "15", "10", "5", "10", "5", "5", "5"],
          ["220002", "OilHand42", "Oil Courier", "85000", "310", "1776099000", "78", "35", "10", "3", "10", "8", "2", "5", "5"],
          ["220003", "TankFillr", "Oil Courier", "82000", "180", "1776090000", "65", "30", "5", "2", "15", "5", "3", "0", "5"],
          ["220004", "FinanceGuru", "Accountant", "110000", "520", "1776098000", "91", "38", "12", "8", "5", "10", "8", "5", "5"],
          ["220005", "TrainerX", "Trainer", "95000", "90", "1776085000", "52", "22", "3", "5", "5", "12", "3", "2", "0"]
        ]
      },
      "Director_Efficiency": {
        "write_style": "append",
        "headers": ["timestamp", "date", "position", "efficiency"],
        "sample_rows": [
          ["1776100000", "2026-07-14 12:00 UTC", "Director", "94.2"],
          ["1776100000", "2026-07-14 12:00 UTC", "Oil Courier", "68.5"],
          ["1776100000", "2026-07-14 12:00 UTC", "Accountant", "82.1"],
          ["1776100000", "2026-07-14 12:00 UTC", "Trainer", "71.3"]
