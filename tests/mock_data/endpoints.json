              "days_in_company": 310, "wage": 85000,
              "last_action": { "timestamp": 1776099000, "status": "Online" },
              "stats": { "manual_labor": 40000, "intelligence": 15000, "endurance": 30000 },
              "effectiveness": { "total": 78, "working_stats": 35, "settled_in": 10, "director_education": 3, "addiction": 10, "inactivity": 8, "management": 2, "book": 5, "merits": 5 }
