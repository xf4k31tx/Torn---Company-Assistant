      },
      "get_company_stock_v2": {
        "method": "GET",
        "url": "v2/company/stock",
        "params": { "key": "{api_key}", "comment": "{comment}" },
        "response": {
          "stock": [
            { "id": 1, "name": "Premium Oil", "in_stock": 250, "on_order": 0, "cost": 450, "price": 1100, "sold_amount": 40, "sold_worth": 44000 },
            { "id": 2, "name": "Standard Oil", "in_stock": 500, "on_order": 100, "cost": 200, "price": 500, "sold_amount": 120, "sold_worth": 60000 },
