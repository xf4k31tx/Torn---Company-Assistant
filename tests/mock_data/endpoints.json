              "effectiveness": { "total": 65, "working_stats": 30, "settled_in": 5, "director_education": 2, "addiction": 15, "inactivity": 5, "management": 3, "book": 0, "merits": 5 }
            },
            {
              "id": 220004, "name": "FinanceGuru", "position": { "id": 3, "name": "Accountant" },
              "days_in_company": 520, "wage": 110000,
              "last_action": { "timestamp": 1776098000, "status": "Online" },
              "stats": { "manual_labor": 5000, "intelligence": 70000, "endurance": 12000 },
              "effectiveness": { "total": 91, "working_stats": 38, "settled_in": 12, "director_education": 8, "addiction": 5, "inactivity": 10, "management": 8, "book": 5, "merits": 5 }
