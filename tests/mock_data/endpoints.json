{
  "_meta": {
    "description": "Mock endpoint definitions and sample responses for Torn API, Tornstats API, and Google Sheets API.",
    "rate_limits": {
      "torn_per_user_per_minute": 100,
      "torn_per_ip_per_minute": 1000,
      "tornstats_unknown": "undocumented"
    }
  },
  "torn_api": {
    "base_urls": {
      "v1": "https://api.torn.com",
      "v2": "https://api.torn.com/v2"
    },
    "endpoints": {
      "get_company_profile_v2": {
        "method": "GET",
        "url": "v2/company/profile",
        "params": { "key": "{api_key}", "comment": "{comment}" },
        "response": {
          "profile": {
            "id": 220001,
            "name": "Knotty Oil Co",
            "rating": 9.2,
            "type": { "id": 12, "name": "Oil Rig" },
            "days_old": 842,
            "employees": { "hired": 5, "capacity": 15 },
            "income": { "daily": 4250000, "weekly": 29750000 },
            "customers": { "daily": 38, "weekly": 266 },
            "funds": 87500000,
            "popularity": 88,
            "efficiency": 92,
            "environment": 71,
            "trains": 3,
            "advertisement_budget": 350000,
            "upgrades": { "staff_room": "Large staff room", "storage": "Warehouse", "storage_capacity": 750 }
          }
        }
      },
      "get_company_employees": {
        "method": "GET",
        "url": "v2/company/employees",
        "params": { "striptags": "true", "key": "{api_key}", "comment": "{comment}" },
